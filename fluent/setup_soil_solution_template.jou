; Fluent journal template for the soil solution percolation model.
; Edit zone names before running:
;   drip-inlet
;   soil-zone
;   bottom-outlet
;
; Run from Fluent working directory at project root:
;   D:\Digital Twin

/define/user-defined/compiled-functions compile soil_solution_lib yes "fluent/soil_solution_percolation_udf.c" "" ""
/define/user-defined/compiled-functions load soil_solution_lib

; Enable four UDS equations in the GUI if your Fluent version does not support
; journal setup for UDS in your license/build.
; UDS-0: EC, UDS-1: N, UDS-2: P, UDS-3: K

; Suggested transient controls. Adjust for mesh size and convergence.
/solve/set/time-step 60
/solve/set/max-iterations-per-time-step 20

; Hook profiles manually if the zone names below do not match your case:
; velocity inlet -> drip_velocity_profile
; UDS-0 inlet -> drip_ec_uds0_profile
; UDS-1 inlet -> drip_n_uds1_profile
; UDS-2 inlet -> drip_p_uds2_profile
; UDS-3 inlet -> drip_k_uds3_profile
; UDS diffusivity -> soil_solution_diffusivity
; UDS sources on soil-zone:
;   UDS-0 -> ec_root_sink
;   UDS-1 -> n_root_sink
;   UDS-2 -> p_root_sink
;   UDS-3 -> k_root_sink

; Initialize after hooks are assigned.
; /solve/initialize/hyb-initialization
