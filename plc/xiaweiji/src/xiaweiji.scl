FUNCTION_BLOCK "RateLimiter"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      target : Real;   // AI输出目标值
      maxRateUp : Real := 5.0;   //  最大上升速率（单位/秒）
      maxRateDown : Real := 5.0;   // 最大下降速率（单位/秒），
      cycleTime : Real := 0.01;   // OB1扫描周期（秒），通常 5~15ms
      enable : Bool := TRUE;   // 斜坡使能
      reset : Bool;   // 复位：输出立即跳变到 target
   END_VAR

   VAR_OUTPUT 
      output : Real;   // 平滑后的输出值
      isLimited : Bool;   // TRUE = 正在限幅（被斜坡钳制）
   END_VAR

   VAR 
      lastOutput : Real;   // 上周期输出值（静态保持）
      initDone : Bool;   // 初始化完成标志
   END_VAR

   VAR_TEMP 
      delta : Real;   // 与目标的偏差
      maxStep : Real;   // 本周期允许的最大步长
   END_VAR


BEGIN
	// ===================================================================
	// RateLimiter — 防震荡物理护盾
	// 将高频跳变的目标值平滑为有限速率的变化曲线，保护物理设备
	// ===================================================================
	
	// --- 首次调用：避免从 0 跳到目标值的阶跃 ---
	IF NOT #initDone THEN
	    #output := #target;
	    #lastOutput := #target;
	    #initDone := TRUE;
	    #isLimited := FALSE;
	    RETURN;
	END_IF;
	
	// --- 复位模式 ---
	IF #reset THEN
	    #output := #target;
	    #lastOutput := #target;
	    #isLimited := FALSE;
	    RETURN;
	END_IF;
	
	// --- 正常斜坡控制 ---
	IF #enable AND #cycleTime > 0.0 THEN
	    #delta := #target - #lastOutput;
	    
	    IF #delta > 0.0 THEN
	        // === 上升方向 ===
	        #maxStep := #maxRateUp * #cycleTime;
	        IF #delta > #maxStep THEN
	            #output := #lastOutput + #maxStep;
	            #isLimited := TRUE;
	        ELSE
	            #output := #target;          // 在允许范围内，直接输出
	            #isLimited := FALSE;
	        END_IF;
	    ELSIF #delta < 0.0 THEN
	        // === 下降方向 ===
	        #maxStep := #maxRateDown * #cycleTime;
	        IF - #delta > #maxStep THEN        // 取绝对值比较
	            #output := #lastOutput - #maxStep;
	            #isLimited := TRUE;
	        ELSE
	            #output := #target;
	            #isLimited := FALSE;
	        END_IF;
	    ELSE
	        // delta = 0，目标未变化
	        #output := #target;
	        #isLimited := FALSE;
	    END_IF;
	ELSE
	    // 斜坡禁用或周期无效 — 直通模式
	    #output := #target;
	    #isLimited := FALSE;
	END_IF;
	
	// --- 保存本周期的输出，供下周期使用 ---
	#lastOutput := #output;
END_FUNCTION_BLOCK

